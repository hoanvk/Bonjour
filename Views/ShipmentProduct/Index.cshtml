@using Microsoft.Extensions.Localization
@model IEnumerable<Bonjour.Domain.Shipments.ShipmentProductDto>;
@{
    ViewData["Title"] = "Product Page";
    Layout = "_AdminLayout";
}
@inject IStringLocalizer<SharedResources> Localizer
<h1 class="mt-4">Product</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Shipment" asp-action="Index">@Localizer["Shipment"]</a></li>
    <li class="breadcrumb-item active">Product</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["Code"]</th>
                    <th scope="col">@Localizer["Name"]</th>
                    <th scope="col">@Localizer["Loaded"]</th>
                    <th scope="col">@Localizer["Unloaded"]</th>
                    <th scope="col">@Localizer["Created At"]</th>
                    <th scope="col">@Localizer["Updated At"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr id="@product.Id">
                        <td>@product.Id</td>
                        <td>@product.Category</td>
                        <td>@product.Name</td>
                        <td>@product.Loaded</td>
                        <td>@product.Unloaded</td>
                        <td>@product.CreatedAt</td>
                        <td>@(product.UpdatedAt.HasValue ?
                                                product.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") :
                                                string.Empty)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-footer">
        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <a asp-controller="ShipmentProduct" asp-action="Export" asp-route-id="@ViewBag.ShipmentId"
                class="btn btn-primary me-md-2" style="width: 100px;" role="button">@Localizer["Export"]</a>
        </div>
    </div>
</div>