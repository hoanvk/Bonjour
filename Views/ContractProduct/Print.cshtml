@model IEnumerable<Bonjour.Dtos.ProductDto>;

@{
    Layout = "_PrintLayout";
    int i = 0;
}
<div class="row g-4">
    @foreach (var productDto in Model)
    {
        <div class="col-lg-2 col-md-3 col-sm-4 @(++i % 9 == 0 ? "page-break-after" : "")">
            <div class="card">
                <img src="@productDto.QrCode" class="card-img-top" alt="qrcode">
                <div class="card-body">
                    <h5 class="card-title">@productDto.Contract</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@productDto.Category</h6>
                    <p class="card-text">@productDto.Name</p>
                </div>
            </div>
        </div>
    }
</div>