@using Microsoft.Extensions.Localization
@model IEnumerable<Bonjour.Models.Product>;
@{
    ViewData["Title"] = "Product Page";
    Layout = "_AdminLayout";
}
@inject IStringLocalizer<SharedResources> Localizer

<h1 class="mt-4">Product</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Contract" asp-action="Index">@Localizer["Contract"]</a></li>
    <li class="breadcrumb-item active">Product</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["Code"]</th>
                    <th scope="col">@Localizer["Name"]</th>
                    <th scope="col">@Localizer["Quantity"]</th>
                    <th scope="col">@Localizer["Delivery"]</th>
                    <th scope="col">@Localizer["Weight"]</th>
                    <th scope="col">@Localizer["Details"]</th>
                    <th scope="col">@Localizer["Created At"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <th scope="row">@product.Id</th>
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@product.Quantity</td>
                        <td>@product.Delivery</td>
                        <td>@product.Weight</td>
                        <td><a asp-action="Details" asp-controller="Product"
                                asp-route-id="@product.Id">@Localizer["Details"]</a></td>
                        <td>@product.CreatedAt</td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importFileModal">
            @Localizer["Import"]
        </button>
        <a class="btn btn-secondary" asp-action="Print" asp-controller="ContractProduct"
            asp-route-id="@ViewBag.ContractId">@Localizer["Print QrCode"]</a>

        <!-- Modal -->
        @Html.Partial("Import.cshtml")
    </div>
</div>