<div class="modal fade" id="changePasswordModal" tabindex="-1" aria-labelledby="changePasswordModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="changePasswordModalLabel">Change Password</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row g-3" asp-action="ChangePassword" method="post" id="changePasswordForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="" />
                    <div class="col-md-12">
                        <label for="Password" class="form-label">Password</label>
                        <input type="password" class="form-control" name="Password">
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-md-12">
                        <label for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <input type="password" class="form-control" name="ConfirmPassword">
                        <div class="invalid-feedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="changePasswordHandler()">Save
                    changes</button>
            </div>
        </div>
    </div>
</div>