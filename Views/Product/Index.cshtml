@model IEnumerable<Bonjour.Models.Product>;
@{
    ViewData["Title"] = "Product Page";
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Product</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Shipment" asp-action="Index">Freight</a></li>
    <li class="breadcrumb-item active">Product</li>
</ol>
<div class="card mt-4">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="Scan" asp-controller="Product" asp-route-id="@ViewBag.id">Shipping</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-action="Index" asp-controller="Product" asp-route-id="@ViewBag.id"
                    aria-current="true">Product</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-controller="Product" asp-action="QrCode" asp-route-id="@ViewBag.id">QrCode</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Code</th>
                    <th scope="col">Name</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Delivery</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <th scope="row">@product.Id</th>
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@product.Quantity</td>
                        <td>@product.Delivery</td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#importFileModal">
            Import
        </button>

        <!-- Modal -->
        <div class="modal fade" id="importFileModal" tabindex="-1" aria-labelledby="exampleModalLabel"
            aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Import products</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="Import" asp-route-id="@ViewBag.id" method="post" id="importProductsForm">
                            @Html.AntiForgeryToken()
                            <div class="mb-3">
                                <label for="formFile" class="form-label">Product files input</label>
                                <input class="form-control" type="file" name="files" multiple accept=".xlsx, .xls">
                            </div>
                        </form>

                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="uploadFilesHandler()">Save
                            changes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script defer>
        function uploadFilesHandler()
        const formElement = document.getElementById("importProductsForm");
        const url = formElement.action;
        const files = formElement.querySelector('input[name="files"]').files;
        const formData = new FormData();
        formData.append('files', files);
        const token = document.querySelector(
            'input[name="__RequestVerificationToken"]'
        ).value;
        axios.post(url, formData, {
            headers: {
                'Content-Type': 'multipart/form-data',
                RequestVerificationToken: token,
            }
        })
            .then((success) => {
                console.log("success :>> ", success);
                Swal.fire({
                    icon: "success",
                    title: "Success!",
                    text: success.data,
                }).then(() => {
                    location.reload();
                });
            })
            .catch((error) => {
                console.log("error :>> ", error);
                Swal.fire({
                    icon: "error",
                    title: "Oops...",
                    text: error.message,
                });
            });
    </script>
}