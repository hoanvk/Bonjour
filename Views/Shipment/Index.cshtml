@using Microsoft.Extensions.Localization
@using Newtonsoft.Json
@model IEnumerable<Bonjour.Models.Shipment>;
@{
    Layout = "_AdminLayout";
}
@inject IStringLocalizer<SharedResources> Localizer
<h1 class="mt-4">@Localizer["Product"]</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Shipment" asp-action="Index">@Localizer["Shipment"]</a></li>
    <li class="breadcrumb-item active">@Localizer["Product"]</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">@Localizer["Shipments"]</h5>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["Carrier"]</th>
                    <th scope="col">@Localizer["Consignee"]</th>
                    <th scope="col">@Localizer["Departure"]</th>
                    <th scope="col">@Localizer["Status"]</th>
                    <th>@Localizer["Products"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in Model)
                {
                    <tr>
                        <th scope="row">@shipment.Id</th>
                        <td>@shipment.Carrier</td>
                        <td>@shipment.Consignee</td>
                        <td>@shipment.Departure</td>
                        <td>@shipment.Status</td>
                        <td><a asp-controller="ShipmentProduct" asp-action="Index" asp-route-id="@shipment.Id">Products</a>
                        </td>
                        <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#editPermissionModal"
                            data-bs-entity="@JsonConvert.SerializeObject(shipment)" onclick="Shipment.edit(button)"><i
                                class="fa fa-edit"></i></button>
                        <td><button class="btn" type="button" onclick="Shipment.remove(@shipment.Id)"><i
                                    class="fa fa-trash"></i></button></td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createShipmentModal">
            Create
        </button>
        <form asp-action="Delete" method="post" id="deleteShipmentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
        </form>
        <!-- Modal -->
        @Html.Partial("Create")
        @Html.Partial("Edit")
    </div>
</div>