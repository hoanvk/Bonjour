@model IEnumerable<Bonjour.Models.ProductDetails>;
@{
    ViewData["Title"] = "Product Details Page";
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Product Details</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Contract" asp-action="Index">Contract</a></li>
    <li class="breadcrumb-item active">Product Details</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">SequenceNo</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created At</th>
                    <th scope="col">Updated At</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var productDetail in Model)
                {
                    <tr>
                        <th scope="row">@productDetail.Id</th>
                        <td>@productDetail.SequenceNo</td>
                        <td>@await Component.InvokeAsync("ProductStatus", new { status = productDetail.Status })</td>
                        <td>@await Component.InvokeAsync("DateTimeDisplay", new { datetime = productDetail.CreatedAt })</td>
                        <td>@await Component.InvokeAsync("DateTimeDisplay", new { datetime = productDetail.UpdatedAt })
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>