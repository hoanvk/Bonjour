@model IEnumerable<Bonjour.Dtos.ProductDto>;

@{
    Layout = "_AdminLayout";
}


<div class="container px-4 text-center">
    <ul class="nav nav-tabs">
        <li class="nav-item">
            <a class="nav-link" asp-controller="Product" asp-action="Scan" asp-route-id="@ViewBag.id">Scan</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" asp-controller="Product" asp-action="Index" asp-route-id="@ViewBag.id">Product</a>
        </li>
        <li class="nav-item">
            <a class="nav-link active" asp-action="QrCode" asp-controller="Shipment" asp-route-id="@ViewBag.id"
                aria-current="true">QrCode</a>
        </li>
    </ul>
    <div class="row gx-5">
        @foreach (var productDto in Model)
        {
            <div class="col-3 p-3">
                <div class="card" style="width: 18rem;">
                    <img src="@productDto.QrCode" class="card-img-top" alt="qrcode">
                    <div class="card-body">
                        <h5 class="card-title">@productDto.Code</h5>
                        <p class="card-text">@productDto.Name</p>
                    </div>

                </div>
                @* <div class="p-3 bg-light">
                            <img src="@productDto.QrCode" class="img-thumbnail" alt="qrcode">
                        </div> *@
            </div>
        }
    </div>
</div>