@using Microsoft.Extensions.Localization
@model IEnumerable<Bonjour.Domain.Shipments.ShipmentProductDto>;
@{
    ViewData["Title"] = "Loading";
    Layout = "_AdminLayout";
}
@inject IStringLocalizer<SharedResources> Localizer
<h1 class="mt-4">Product</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Shipment" asp-action="Index">@Localizer["Shipment"]</a></li>
    <li class="breadcrumb-item active">@Localizer["Product"]</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <table class="table table-dark table-striped" id="products">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["Code"]</th>
                    <th scope="col">@Localizer["Name"]</th>
                    <th scope="col">@Localizer["Loaded"]</th>
                    <th scope="col">@Localizer["Unloaded"]</th>
                    <th scope="col">@Localizer["Created At"]</th>
                    <th scope="col">@Localizer["Updated At"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr id="@product.Id">
                        <td scope="row" data-column="id">
                            <i class="fa-regular fa-circle"></i>
                        </td>
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td data-column="loaded">@product.Loaded</td>
                        <td>@product.Unloaded</td>
                        <td>@product.CreatedAt</td>
                        <td data-column="updated_at">@(product.UpdatedAt.HasValue ?
                                                product.UpdatedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") :
                                                string.Empty)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
            <a asp-controller="Loading" asp-action="Scan" asp-route-id="@ViewBag.ShipmentId"
                class="btn btn-primary me-md-2" style="width: 100px;" role="button">@Localizer["Scan"]</a>
            <!-- Button trigger modal -->
            <button type="button" class="btn btn-primary" style="width: 100px;" onclick="confirmLoadedHandler()">
                @Localizer["Confirm"]
            </button>
            <!-- Modal -->
        </div>

    </div>
</div>
@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/5.0.11/signalr.min.js"></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function () {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/realtimehub")
                .withAutomaticReconnect()
                .build();
            const tableElement = document.getElementById("products");
            connection.on("ReceiveNotification", (product) => {
                console.log(`Notification: ${JSON.stringify(product)}`);
                var rowElement = document.getElementById(product.id);
                if (rowElement) {
                    console.log('updated');
                    var loadedColumn = rowElement.querySelector('[data-column="loaded"]');
                    updateContentAndFlash(loadedColumn, product.loaded);
                    var updatedAtColumn = rowElement.querySelector('[data-column="updated_at"]');
                    updateContentAndFlash(updatedAtColumn, product.updatedAt);
                }
                else {
                    console.log('inserted');
                    let rowElement = tableElement.insertRow(-1);
                    rowElement.setAttribute('id', product.id);
                    let idCellElement = rowElement.insertCell(0);
                    idCellElement.innerHTML = '<i class="fa-regular fa-circle"></i>';
                    idCellElement.setAttribute('data-column', 'id');
                    let codeCellElement = rowElement.insertCell(1);
                    codeCellElement.innerText = product.code;
                    let nameCellElement = rowElement.insertCell(2);
                    nameCellElement.innerText = product.name;
                    let loadedCellElement = rowElement.insertCell(3);
                    loadedCellElement.innerText = product.loaded;
                    loadedCellElement.setAttribute('data-column', 'loaded');
                    let unloadedCellElement = rowElement.insertCell(4);
                    unloadedCellElement.innerText = product.unloaded;
                    let createdAtCellElement = rowElement.insertCell(5);
                    createdAtCellElement.innerText = product.createdAt;
                    let updatedAtCellElement = rowElement.insertCell(6);
                    updatedAtCellElement.innerText = product.updatedAt;
                    updatedAtCellElement.setAttribute('data-column', 'updated_at');
                }
            });

            connection.start().catch(err => console.error(err));

            function sendNotification() {
                const message = document.getElementById("product_id").value;
                connection.invoke("SendNotification", message).catch(err => console.error(err));
            }

        });

        function updateContentAndFlash(elementToFlash, newContent) {
            elementToFlash.textContent = newContent;
            elementToFlash.classList.add('flash-on-update');

            // Remove the class after the animation duration to allow re-triggering
            setTimeout(() => {
                elementToFlash.classList.remove('flash-on-update');
            }, 500); // Match animation duration
        }

        function confirmLoadedHandler() {
            ConfirmDialog(
                'Confirm shipment loaded',
                'Are you sure you want to confirm loaded products?',
                () => {
                    const url = "@Url.Action("Confirm", "Loading", new { id = ViewBag.ShipmentId })";
                    createHttpPost(url, null);
                });
        }
    </script>

}