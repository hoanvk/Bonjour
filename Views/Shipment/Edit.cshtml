@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> Localizer

<div class="modal fade" id="editShipmentModal" tabindex="-1" aria-labelledby="editShipmentModalLabel"
    aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="editShipmentModalLabel">@Localizer["Edit Shipment"]</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row g-3" asp-action="Edit" method="post" id="editShipmentForm" asp-route-id="__id">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="" route-id/>
                    <div class="col-md-12">
                        <label for="carrier" class="form-label">@Localizer["Carrier"]</label>
                        <input type="text" class="form-control" id="carrier" name="carrier" placeholder="carrier">
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-md-12">
                        <label for="consignee" class="form-label">@Localizer["Consignee"]</label>
                        <input type="text" class="form-control" id="consignee" name="consignee" placeholder="consignee">
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="col-md-6">
                        <label for="departure" class="form-label">@Localizer["Departure"]</label>
                        <input type="text" class="form-control date" id="departure" name="departure">
                        <div class="invalid-feedback"></div>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Localizer["Close"]</button>
                <button type="button" class="btn btn-primary" onclick="Shipment.update()">@Localizer["Save changes"]</button>
            </div>
        </div>
    </div>
</div>