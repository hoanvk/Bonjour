@model IEnumerable<Bonjour.Models.Shipment>;
@{
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Product</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-controller="Shipment" asp-action="Index">Shipment</a></li>
    <li class="breadcrumb-item active">Product</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Shipments</h5>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Carrier</th>
                    <th scope="col">Consignee</th>
                    <th scope="col">Departure</th>
                    <th scope="col">Status</th>
                    <th>Products</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var shipment in Model)
                {
                    <tr>
                        <th scope="row">@shipment.Id</th>
                        <td>@shipment.Carrier</td>
                        <td>@shipment.Consignee</td>
                        <td>@shipment.Departure</td>
                        <td>@shipment.Status</td>
                        <td><a asp-controller="ShipmentProduct" asp-action="Index" asp-route-id="@shipment.Id">Products</a>
                        </td>
                        <td><button class="btn" type="button" onclick="deleteShipmentHandler(@shipment.Id)"><i
                                    class="fa fa-trash"></i></button></td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createShipmentModal">
            Create
        </button>
        <form asp-action="Delete" method="post" id="deleteShipmentForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
        </form>
        <!-- Modal -->
        @Html.Partial("Create")
    </div>
</div>
@section Scripts {
    <script defer>
        function createShipmentHandler() {
            const token = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            ).value;
            var data = {
                carrier: document.querySelector("#carrier").value,
                consignee: document.querySelector("#consignee").value,
                departure: document.querySelector("#departure").value,
            }
            submitFormData("createShipmentForm", [
                "input[name='carrier']",
                "input[name='consignee']",
                "input[name='departure']"
            ]);
        }
        function deleteShipmentHandler(id) {
            const form = document.getElementById("deleteShipmentForm");
            const shipmentIdElement = form.querySelector('input[name="id"]');
            shipmentIdElement.value = id;
            submitFormData("deleteShipmentForm", ["input[name='id']"]);
        }
    </script>
}