@model IEnumerable<Bonjour.Models.Product>;
@{
    ViewData["Title"] = "Product Page";
    Layout = "_AdminLayout";
}

<div class="card mt-4">
    <div class="card-header">
        <ul class="nav nav-tabs card-header-tabs">
            <li class="nav-item">
                <a class="nav-link" asp-action="Scan" asp-controller="Product" asp-route-id="@ViewBag.id">Scan</a>
            </li>
            <li class="nav-item">
                <a class="nav-link active" asp-action="Index" asp-controller="Product" asp-route-id="@ViewBag.id"
                    aria-current="true">Product</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-action="QrCode" asp-controller="Shipment" asp-route-id="@ViewBag.id">QrCode</a>
            </li>
        </ul>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Code</th>
                    <th scope="col">Name</th>
                    <th scope="col">Quantity</th>
                    <th scope="col">Delivery</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <th scope="row">@product.Id</th>
                        <td>@product.Code</td>
                        <td>@product.Name</td>
                        <td>@product.Quantity</td>
                        <td>@product.Delivery</td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
            Import
        </button>

        <!-- Modal -->
        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form asp-action="Import" method="post" asp-route-id="@ViewBag.id" id="form-import">
                            <div class="dropzone" id="myDropzone">

                            </div>
                        </form>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            uploadFiles({
                selector: '#myDropzone',
                options: {
                    url: document.querySelector('#form-import').action,
                    paramName: 'files',
                    acceptedFiles: '.xlsx,.xls',
                }
            })
        });
    </script>

}