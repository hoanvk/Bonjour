@using Newtonsoft.Json
@model IEnumerable<Bonjour.Models.User>;
@{
    Layout = "_AdminLayout";
}
<h1 class="mt-4">User</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
    <li class="breadcrumb-item active">User</li>
</ol>
<div class="card mb-4">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Username</th>
                    <th scope="col">Role</th>
                    <th scope="col">Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <th scope="row">@user.Id</th>
                        <td>@user.Name</td>
                        <td>@user.Username</td>
                        <td>@user.RoleId</td>
                        <td>@user.CreatedAt</td>
                        <td>
                            <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#editUserModal"
                                data-bs-entity="@JsonConvert.SerializeObject(user)" onclick="User.edit(this)"><i
                                    class="fa-solid fa-user"></i></button>
                            <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#changePasswordModal"
                                data-bs-entity="@JsonConvert.SerializeObject(user)" onclick="User.changePassword(this)"><i
                                    class="fa fa-key"></i></button>
                            <button class="btn" type="button" onclick="User.remove(@user.Id)"><i
                                    class="fa fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">
            Create
        </button>
        <form asp-action="Delete" method="post" id="deleteUserForm" asp-route-id="__id">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" route-id />
        </form>
        <!-- Modal -->
        @Html.Partial("Create")
        @Html.Partial("ChangePassword")
        @Html.Partial("Edit")
    </div>
</div>