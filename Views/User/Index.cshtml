@model IEnumerable<Bonjour.Models.User>;
@{
    Layout = "_AdminLayout";
}
<h1 class="mt-4">User</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item"><a asp-action="Index" asp-controller="Home">Home</a></li>
    <li class="breadcrumb-item active">User</li>
</ol>
<div class="card mb-4">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Username</th>
                    <th scope="col">CreatedAt</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <th scope="row">@user.Id</th>
                        <td>@user.Name</td>
                        <td>@user.Username</td>
                        <td>@user.CreatedAt</td>
                        <td><button class="btn" type="button" onclick="removeUserHandler(@user.Id)"><i
                                    class="fa fa-trash"></i></button></td>

                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
            Create
        </button>
        <form asp-action="Delete" method="post" id="deleteUserForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
        </form>
        <!-- Modal -->
        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Create User</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form class="form-floating" asp-action="Create" method="post" id="createUserForm">
                            @Html.AntiForgeryToken()
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="Name" name="Name" placeholder="Joe Doe">
                                <label for="Name">Name</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="text" class="form-control" id="Username" name="Username"
                                    placeholder="joedoe">
                                <label for="Username">Username</label>
                            </div>
                            <div class="form-floating mb-3">
                                <input type="password" class="form-control" id="Password" name="Password">
                                <label for="Password">Password</label>
                            </div>
                            <div class="form-floating">
                                <input type="password" class="form-control" id="ConfirmPassword" name="ConfirmPassword">
                                <label for="ConfirmPassword">Confirm Password</label>
                            </div>
                        </form>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                        <button type="button" class="btn btn-primary" onclick="createUserHandler()">Save
                            changes</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <script defer>
        function createUserHandler() {
            submitFormData("createUserForm", [
                'input[name="Name"]',
                'input[name="Username"]',
                'input[name="Password"]',
                'input[name="ConfirmPassword"]'
            ]);
            console.log("Create clicked");
        }

        function removeUserHandler(id) {
            const form = document.getElementById("deleteUserForm");
            const userIdElement = form.querySelector('input[name="id"]');
            userIdElement.value = id;
            submitFormData("deleteUserForm", ["input[name='id']"]);
            console.log("Delete clicked");
        }
    </script>
}