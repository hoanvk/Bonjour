@model IEnumerable<Bonjour.Models.Permission>
<div class="modal fade" id="editRoleModal" tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="editRoleModalLabel">Edit Role</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="row g-3" asp-action="Edit" method="post" id="editRoleForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="" />
                    <div class="col-md-12">
                        <label for="Name" class="form-label">Name</label>
                        <input type="text" class="form-control" id="Name" name="Name" placeholder="Name">
                        <div class="invalid-feedback"></div>
                    </div>
                    <input type="hidden" name="Permissions" />
                    <div class="col-md-12">
                        <table class="table">
                            @foreach (var permission in Model)
                            {
                                <tr>
                                    <td>@permission.Name</td>
                                    <td>
                                        <div class="d-flex">
                                            <input type="hidden" name="Permission" value="@permission.Id" />
                                            <div class="form-check me-3 ">
                                                <input class="form-check-input" type="checkbox" name="Read" />
                                                <label class="form-check-label" for="readCheck">
                                                    Read
                                                </label>
                                            </div>
                                            <div class="form-check me-3">
                                                <input class="form-check-input" type="checkbox" name="Write" />
                                                <label class="form-check-label" for="readCheck">
                                                    Write
                                                </label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="Create" />
                                                <label class="form-check-label" for="readCheck">
                                                    Create
                                                </label>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </table>
                    </div>

                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary" onclick="editRoleHandler()">Save
                    changes</button>
            </div>
        </div>
    </div>
</div>