@using Newtonsoft.Json
@using Microsoft.Extensions.Localization
@model IEnumerable<Bonjour.Models.Contract>;
@{
    Layout = "_AdminLayout";
}
@inject IStringLocalizer<SharedResources> Localizer
<h1 class="mt-4">@Localizer["Contract"]</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">@Localizer["Contract"]</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">@Localizer["Contracts"]</h5>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">@Localizer["Name"]</th>
                    <th scope="col">@Localizer["Customer"]</th>
                    <th scope="col">@Localizer["Start Date"]</th>
                    <th scope="col">@Localizer["End Date"]</th>
                    <th scope="col">@Localizer["Products"]</th>
                    <th scope="col">@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in Model)
                {
                    <tr>
                        <th scope="row">@contract.Id</th>
                        <td>@contract.Name</td>
                        <td>@contract.Customer</td>
                        <td>@contract.StartDate</td>
                        <td>@contract.EndDate</td>
                        <td><a asp-controller="ContractProduct" asp-action="Index"
                                asp-route-id="@contract.Id">@Localizer["Products"]</a>
                        </td>
                        <td>
                            <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#editContractModal"
                                data-bs-entity="@JsonConvert.SerializeObject(contract)"><i class="fa fa-edit"></i></button>
                            <button class="btn" type="button" onclick="Contract.deleteContractHandler(@contract.Id)"><i
                                    class="fa fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createContractModal">
            @Localizer["Create"]
        </button>
        <form asp-action="Delete" method="post" id="deleteContractForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
        </form>
        <!-- Modal -->
        @Html.Partial("Create.cshtml")
        @Html.Partial("Edit.cshtml")
    </div>
</div>
@section Scripts {
    <script defer>
        Contract.showContractHandler()
    </script>
}