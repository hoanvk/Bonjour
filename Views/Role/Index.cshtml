@using Newtonsoft.Json
@model IEnumerable<Bonjour.Models.Role>;
@{
    Layout = "_AdminLayout";
}
<h1 class="mt-4">Role</h1>
<ol class="breadcrumb mb-4">
    <li class="breadcrumb-item active">Role</li>
</ol>
<div class="card mt-4">
    <div class="card-body">
        <h5 class="card-title">Roles</h5>
        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Name</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td scope="row">@role.Id</td>
                        <td>@role.Name</td>
                        <td>
                            <button class="btn" type="button" data-bs-toggle="modal" data-bs-target="#editRoleModal"
                                data-bs-entity="@JsonConvert.SerializeObject(role)" onclick="Role.edit(this)"><i
                                    class="fa fa-edit"></i></button>
                            <button class="btn" type="button" onclick="Role.remove(@role.Id)"><i
                                    class="fa fa-trash"></i></button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <!-- Button trigger modal -->
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createRoleModal">
            Create
        </button>
        <form asp-action="Delete" method="post" id="deleteRoleForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="" />
        </form>
        <!-- Modal -->
        @Html.Partial("Create.cshtml", (IEnumerable<Bonjour.Models.Permission>)ViewBag.Permissions)
        @Html.Partial("Edit.cshtml", (IEnumerable<Bonjour.Models.Permission>)ViewBag.Permissions)
    </div>
</div>